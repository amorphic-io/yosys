# Generate rules for every *.pmg we know about ---------------------
_PM_HDRS = [
    "techlibs/microchip/microchip_dsp_CREG_pm.h",
    "techlibs/microchip/microchip_dsp_pm.h",
    "techlibs/microchip/microchip_dsp_cascade_pm.h",
    "techlibs/xilinx/xilinx_dsp48a_pm.h",
    "techlibs/xilinx/xilinx_dsp_cascade_pm.h",
    "techlibs/xilinx/xilinx_srl_pm.h",
    "techlibs/xilinx/xilinx_dsp_CREG_pm.h",
    "techlibs/xilinx/xilinx_dsp_pm.h",
    "techlibs/ice40/ice40_wrapcarry_pm.h",
    "techlibs/ice40/ice40_dsp_pm.h",
    "techlibs/quicklogic/ql_dsp_macc_pm.h",
]

[pm_rule(_pmg.replace("/", "_").replace(".", "_") + "_pm_h", _pmg.replace("_pm.h", ".pmg"))
 for _pmg in _PM_HDRS]

genrule(
    name = "peepopt_pm_h",
    srcs = [
        "passes/opt/peepopt_shiftmul_left.pmg",
        "passes/opt/peepopt_muldiv.pmg",
        "passes/opt/peepopt_formal_clockgateff.pmg",
        "passes/opt/peepopt_shiftmul_right.pmg",
        "passes/opt/peepopt_shiftadd.pmg",
    ],
    outs = ["passes/opt/peepopt_pm.h"],
    cmd = "$(location :pmgen) -o $(OUTS) -p peepopt $(SRCS)",
    tools = [
        ":pmgen",
    ],
)

PM_H = _PM_HDRS + [
    "passes/opt/peepopt_pm.h",
]

YOSYS_COPTS = [
    "-fexceptions",
    "-Wno-implicit-fallthrough",
    "-Wno-maybe-uninitialized",
    "-Wno-misleading-indentation",
    "-Wno-unused-but-set-variable",
    "-Wno-unused-variable",
    "-Wno-unknown-warning-option",   # GCC vs Clang
    "-std=c++17",                    # new
    "-DYOSYS_SRC='\"./\"'",
]

cc_library(
    name = "kernel",
    srcs = glob(
        [
            "kernel/*.cc",
            "backends/**/*.cc",
            "frontends/**/*.cc",
            "passes/**/*.cc",
            "techlibs/**/*.cc",
        ],
        exclude = [
            "kernel/driver.cc",                          # binary only
            "backends/cxxrtl/runtime/**/*.cc",           # still optional
            "backends/protobuf/*.cc",                    # optional
            "passes/techmap/filterlib.cc",               # plugin
            "passes/pmgen/test_pmgen.cc",
        ],
    ) + [
        ":verilog_lexer",
        ":verilog_parser",
        ":rtlil_parser",
        ":rtlil_lexer",
        "techlibs/common/techmap.inc",
        "techlibs/common/simlib_help.inc",
        "techlibs/common/simcells_help.inc",
    ],
    hdrs = glob(
        [
            "kernel/*.h",
            "kernel/*.inc",
            "backends/**/*.h",
            "frontends/**/*.h",
            "passes/**/*.h",
            "techlibs/**/*.inc",

        ],
        exclude = [
            "backends/protobuf/*.h",
            "backends/cxxrtl/runtime/**/*.h",
        ],
    ) + PM_H,
    copts = YOSYS_COPTS,
    features = ["-use_header_modules"],
    includes = [
        "backends/ilang",
        "frontends/verilog",
        "frontends/rtlil",
        "passes/techmap",
        "techlibs/common",
    ],
    defines = [
        "_YOSYS_",
        "YOSYS_ENABLE_PLUGINS",
        "YOSYS_ENABLE_READLINE",
        "YOSYS_ENABLE_GLOB",
        "YOSYS_ENABLE_TCL",
        "YOSYS_ENABLE_ABC",
        "YOSYS_ENABLE_COVER",
        'ABCEXTERNAL=\\"abc\\"',
    ],
    deps = [
        ":bigint",
        ":ezsat",
        ":minisat",
        ":json11",
        ":sha1",
        ":subcircuit",
        ":fst",
        ":cxxopts",
        "@zlib//:zlib",                 # new – direct zlib refs
        "@readline//:readline",
        "@abc//:abc",
        "@libffi//:libffi",
        "@tcl//:tcl",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "yosys-bin",
    srcs = ["kernel/driver.cc"],
    copts = YOSYS_COPTS,
    features = ["-use_header_modules"],
    deps = [
        ":kernel",
        ":version",
        ":cxxopts",
        "@readline//:readline",
        "@zlib//:zlib",
    ],
    visibility = ["//visibility:public"],
)

# Wrapper that inserts required env vars such as
# YOSYS_DATDIR.
sh_binary(
    name = "yosys",
    srcs = ["yosys.sh"],
    data = [
        ":yosys-bin",
        ":share_files",
        "@abc//:abc_bin",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    output_licenses = ["unencumbered"],
    visibility = ["//visibility:public"],
)

move_files(
  name = "common_techlibs",
  srcs = glob([
    "techlibs/common/*.v",
  ]),
  destination = "techlibs",
)

# So we can use the internal bzl dep without
# patching the repo.
# We are generating a double header to avoid recursive includes.
genrule(
    name = "_json11_stub_gen",
    outs = ["_json11_stub.hpp"],
    cmd = "\n".join([
        "cat <<'EOF' >$@\n",
        "#include \"json11.hpp\"",
        "EOF"
    ]),
)

cc_library(
    name = "json11_stub",
    hdrs = [
        "_json11_stub.hpp",
    ],
    deps = [
        "@json11",
    ],
)

genrule(
    name = "json11_header_gen",
    outs = ["libs/json11/json11.hpp"],
    cmd = "\n".join([
        "cat <<'EOF' >$@\n",
        "#include \"_json11_stub.hpp\"",
        "EOF"
    ]),
)

cc_library(
    name = "json11",
    hdrs = [
        "libs/json11/json11.hpp",
    ],
    deps = [
        ":json11_stub",
    ],
    includes = ["libs/json11"],
)

filegroup(
  name = "share_files",
  srcs = glob(
    include = [
      "techlibs/**/*.v",
      "techlibs/**/*.vh",
      "techlibs/**/*.lib",
      "techlibs/**/*.txt",
    ],
    exclude = [
        "techlibs/common/*.v",
    ]
  ) + [
    ":common_techlibs"
  ],
)

