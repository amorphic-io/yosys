"""
Yosys is a framework for RTL synthesis tools. It currently has extensive
Verilog-2005 support and provides a basic set of synthesis algorithms for
various application domains.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("//bazel:yosys.bzl", "yosys_syntax_check", "move_files", "pm_rule")
load("//bazel:yacclex_helpers.bzl", "genyacc", "genlex")

licenses(["restricted"])

exports_files(["LICENSE"])

genrule(
    name = "version_src",
    outs = ["kernel/version.cc"],
    cmd = "echo 'namespace Yosys { " +
          "extern const char *yosys_version_str; " +
          "const char *yosys_version_str=\"Yosys 0.52+139\"; " +
          "}' >$@",
)

cc_library(
    name = "version",
    srcs = ["kernel/version.cc"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "techmap",
    srcs = ["techlibs/common/techmap.v"],
    outs = ["techlibs/common/techmap.inc"],
    cmd = ("echo '// autogenerated from techmap.v' > $@ && " +
           "echo 'static char stdcells_code[] = {' >> $@ && " +
           "od -v -td1 -An $< | sed -e 's/[0-9][0-9]*/&,/g' >> $@ && " +
           "echo '0};' >> $@"),
)

genlex(
    name = "verilog_lexer",
    src = "frontends/verilog/verilog_lexer.l",
    out = "verilog_lexer.cc",
)

